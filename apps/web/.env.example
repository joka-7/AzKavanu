# OAuth 2.0 client ID of type "Web application" from Google Cloud Console.
# Without it the app runs in local-only mode (no Drive sync).
VITE_GOOGLE_CLIENT_ID=

# Needed only for joining study groups created by other people (Google Picker).
# API key restricted to the Picker API, and the Cloud project number.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
